{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "nitaaq/review.json",
 "title": "review",
 "type": "object",
 "required": [
  "finding_id",
  "status",
  "issues",
  "mode"
 ],
 "properties": {
  "finding_id": {
   "type": "string"
  },
  "status": {
   "type": "string",
   "enum": [
    "pass",
    "revise",
    "fail"
   ]
  },
  "issues": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "code",
     "severity",
     "message_ar"
    ],
    "properties": {
     "code": {
      "type": "string"
     },
     "severity": {
      "type": "string",
      "enum": [
       "blocking",
       "warning"
      ]
     },
     "message_ar": {
      "type": "string"
     }
    },
    "additionalProperties": true
   }
  },
  "mode": {
   "type": "string",
   "enum": [
    "independent_context",
    "self_check"
   ]
  }
 },
 "additionalProperties": true
}
