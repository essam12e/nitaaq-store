{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "nitaaq/action-proposal.json",
 "title": "action-proposal",
 "type": "object",
 "required": [
  "proposal_id",
  "store_id",
  "operation",
  "items",
  "sensitivity",
  "reversible",
  "customer_visible",
  "source_findings",
  "proposed_by"
 ],
 "properties": {
  "proposal_id": {
   "type": "string"
  },
  "store_id": {
   "type": "string"
  },
  "operation": {
   "type": "string"
  },
  "items": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "entity_id",
     "before",
     "after"
    ],
    "properties": {
     "entity_id": {
      "type": "string"
     },
     "label_ar": {
      "type": "string"
     },
     "before": {
      "type": "object"
     },
     "after": {
      "type": "object"
     },
     "snapshot_hash": {
      "type": "string"
     }
    },
    "additionalProperties": true
   }
  },
  "payload_hash": {
   "type": "string"
  },
  "sensitivity": {
   "type": "string",
   "enum": [
    "low",
    "medium",
    "high"
   ]
  },
  "reversible": {
   "type": "boolean"
  },
  "customer_visible": {
   "type": "boolean"
  },
  "source_findings": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "proposed_by": {
   "type": "string"
  },
  "note_ar": {
   "type": "string"
  }
 },
 "additionalProperties": true
}
