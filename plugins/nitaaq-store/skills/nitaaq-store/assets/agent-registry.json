{
  "version": "1",
  "_note": "Machine-readable roster for Nitaaq's internal team. An entry grants NO access to Salla or any other service: access comes only from tools the host actually exposes. Only entries with status 'active' are routed to; 'planned' entries document later phases and are reported as not yet available. tools/gen_agents.py builds native agent files (Claude Code plugin, Codex) from entries that have a 'native' block.",
  "limits": {
    "max_delegation_depth": 1,
    "max_specialists_simple": 1,
    "max_specialists_broad": 4,
    "max_specialists_absolute": 6,
    "max_review_rounds": 1,
    "max_stage_attempts": 2,
    "stage_timeout_minutes": 10,
    "max_pages_per_fetch": 50
  },
  "agents": [
    {
      "id": "orchestrator",
      "kind": "main",
      "status": "active",
      "version": "1.0.0",
      "label_ar": "المنسّق",
      "mission": "Plan the merchant's request: store, period, request kind, evidence needed, available capabilities, which specialists, order, review; then merge results into one Arabic answer.",
      "reference": "references/orchestrator.md",
      "direct_writes": "prohibited",
      "upstream": [{"path": "specialized/agents-orchestrator.md", "use": "evidence-based gates, bounded retries, stage state"}]
    },
    {
      "id": "salla_operator",
      "kind": "main",
      "status": "active",
      "version": "1.0.0",
      "label_ar": "مشغّل سلة",
      "mission": "Salla-specific data access and the only write path: discover and validate tools, resolve entities, fetch evidence with pagination and coverage, validate proposals, execute approved changes, re-read, verify and report.",
      "reference": "references/salla-operator.md",
      "direct_writes": "only_path",
      "upstream": []
    },
    {
      "id": "store_analytics",
      "kind": "specialist",
      "status": "active",
      "phase": 1,
      "version": "1.0.0",
      "label_ar": "محلل المتجر",
      "mission": "Measure what changed in Salla sales and where, from authorized evidence only, with deterministic numbers and stated coverage.",
      "reference": "references/agents/store-analytics.md",
      "routing": {"intents": ["sales_change", "sales_report", "product_performance", "customer_mix", "broad_improvement"]},
      "capabilities": {"required_any": [["orders.list"], ["reports.sales"], ["export:orders"]],
                       "optional": ["products.list", "customers.list", "coupons.list", "reports.summary", "inventory.read"]},
      "allowed_reads": ["orders.list", "orders.get", "orders.statuses", "products.list", "products.get", "customers.list",
                        "coupons.list", "reports.summary", "reports.sales", "inventory.read"],
      "direct_writes": "prohibited",
      "input_schema": "schemas/task-envelope.json",
      "output_schema": "schemas/finding.json",
      "evidence_rules": ["two_comparable_periods", "pagination_complete_or_labelled", "dedup_by_order_id", "timezone_stated"],
      "uncertainty_rules": ["no_causal_claim_without_mechanism_evidence", "missing_is_not_zero"],
      "review": {"required_when": ["priority:high", "claims_cause", "action_proposal_sensitive"], "reviewer": "reviewer"},
      "budget": {"max_tool_calls": 25, "max_evidence_records_in_context": 200, "max_minutes": 10},
      "fallback": "sequential",
      "native": {
        "name": "nitaaq-store-analytics",
        "description": "Nitaaq Store internal specialist. Analyses Salla sales evidence files prepared by the Nitaaq orchestrator (period comparison, where a change happened). Read-only; never calls store tools. Use only when the nitaaq-store skill delegates a store_analytics stage.",
        "claude_code": {"tools": ["Read", "Grep", "Glob", "Bash"], "disallowedTools": ["Write", "Edit", "NotebookEdit", "Agent", "mcp__*"]},
        "codex": {"sandbox_mode": "read-only"}
      },
      "upstream": [{"path": "support/support-analytics-reporter.md", "use": "data quality first, documented sources, reproducible analysis"}]
    },
    {
      "id": "reviewer",
      "kind": "reviewer",
      "status": "active",
      "phase": 1,
      "version": "1.0.0",
      "label_ar": "المراجع",
      "mission": "Check material findings against their evidence: recompute numbers, reject unsupported causes and invented benchmarks, flag non-independent agreement and missing coverage.",
      "reference": "references/agents/reviewer.md",
      "routing": {"intents": []},
      "capabilities": {"required_any": [], "optional": []},
      "allowed_reads": [],
      "direct_writes": "prohibited",
      "input_schema": "schemas/finding.json",
      "output_schema": "schemas/review.json",
      "budget": {"max_tool_calls": 15, "max_minutes": 5},
      "fallback": "sequential",
      "native": {
        "name": "nitaaq-reviewer",
        "description": "Nitaaq Store internal reviewer. Checks findings JSON against the evidence files they cite (recomputes numbers, flags unsupported causes, invented benchmarks, partial data). Read-only; never calls store tools. Use only when the nitaaq-store skill delegates a review stage.",
        "claude_code": {"tools": ["Read", "Grep", "Glob", "Bash"], "disallowedTools": ["Write", "Edit", "NotebookEdit", "Agent", "mcp__*"]},
        "codex": {"sandbox_mode": "read-only"}
      },
      "upstream": [{"path": "testing/testing-reality-checker.md", "use": "default skepticism, cross-check every claim against evidence"},
                   {"path": "research/research-synthesist.md", "use": "circular sources are one data point; state what was not found"}]
    },
    {"id": "pricing", "kind": "specialist", "status": "planned", "phase": 2, "label_ar": "محلل التسعير",
     "routing": {"intents": ["pricing", "broad_improvement"], "signals": ["price_changed", "offer_ended", "discount_heavy"]},
     "capabilities": {"required_any": [["products.list"], ["export:products"], ["public:pages"]], "optional": ["coupons.list", "offers.list", "orders.list"]},
     "upstream": [{"path": "specialized/specialized-pricing-analyst.md"}]},
    {"id": "growth", "kind": "specialist", "status": "planned", "phase": 2, "label_ar": "محلل النمو",
     "routing": {"intents": ["growth", "broad_improvement"], "signals": ["traffic_available", "funnel_drop"]},
     "capabilities": {"required_any": [["orders.list", "customers.list"], ["export:orders"]], "optional": ["external:analytics", "external:ads", "carts.abandoned"]},
     "upstream": [{"path": "marketing/marketing-growth-hacker.md"}, {"path": "project-management/project-management-experiment-tracker.md"}]},
    {"id": "cro", "kind": "specialist", "status": "planned", "phase": 2, "label_ar": "محسّن التحويل",
     "routing": {"intents": ["cro", "broad_improvement"], "signals": ["funnel_drop", "abandoned_carts_up"]},
     "capabilities": {"required_any": [["public:pages"]], "optional": ["external:analytics", "carts.abandoned"]},
     "upstream": [{"path": "product/product-behavioral-nudge-engine.md", "note": "weak match; mostly custom"}]},
    {"id": "seo_geo", "kind": "specialist", "status": "planned", "phase": 3, "label_ar": "ظهور المتجر SEO/GEO",
     "routing": {"intents": ["seo"]},
     "capabilities": {"required_any": [["public:pages"]], "optional": ["products.list", "products.update", "export:gsc"]},
     "note": "The existing SEO/GEO service (references/seo-geo.md) keeps running as today; phase 3 wraps it as a routed stage.",
     "upstream": [{"path": "marketing/marketing-seo-specialist.md"}, {"path": "marketing/marketing-ai-citation-strategist.md"}]},
    {"id": "customer_intelligence", "kind": "specialist", "status": "planned", "phase": 3, "label_ar": "صوت العميل",
     "routing": {"intents": ["reviews"], "signals": ["complaints_up", "low_ratings"]},
     "capabilities": {"required_any": [["reviews.list"], ["export:reviews"]], "optional": ["orders.get"]},
     "upstream": [{"path": "product/product-feedback-synthesizer.md"}, {"path": "research/research-synthesist.md"}]},
    {"id": "tracking", "kind": "specialist", "status": "planned", "phase": 4, "label_ar": "التتبع والقياس",
     "routing": {"intents": ["tracking"], "signals": ["tracking_discrepancy"]},
     "capabilities": {"required_any": [["public:pages"]], "optional": ["external:analytics", "external:ads", "export:ads"]},
     "upstream": [{"path": "paid-media/paid-media-tracking-specialist.md"}]},
    {"id": "paid_media_auditor", "kind": "specialist", "status": "planned", "phase": 5, "label_ar": "مدقق الإعلانات",
     "routing": {"intents": ["ads"], "signals": ["ads_available"]},
     "capabilities": {"required_any": [["external:ads"], ["export:ads"]], "optional": []},
     "upstream": [{"path": "paid-media/paid-media-auditor.md"}]},
    {"id": "ppc", "kind": "specialist", "status": "planned", "phase": 5, "label_ar": "حملات Google",
     "routing": {"intents": ["ads"]},
     "capabilities": {"required_any": [["external:google_ads"], ["export:google_ads"]], "optional": []},
     "upstream": [{"path": "paid-media/paid-media-ppc-strategist.md"}]},
    {"id": "search_query_analyst", "kind": "specialist", "status": "planned", "phase": 5, "label_ar": "محلل مصطلحات البحث",
     "routing": {"intents": ["ads"], "signals": ["search_terms_available"]},
     "capabilities": {"required_any": [["external:google_ads"], ["export:search_terms"]], "optional": []},
     "upstream": [{"path": "paid-media/paid-media-search-query-analyst.md"}]},
    {"id": "ad_creative", "kind": "specialist", "status": "planned", "phase": 5, "label_ar": "إبداعات الإعلانات",
     "routing": {"intents": ["ads"]},
     "capabilities": {"required_any": [["products.list"], ["public:pages"]], "optional": ["external:ads", "export:ads"]},
     "upstream": [{"path": "paid-media/paid-media-creative-strategist.md"}]},
    {"id": "paid_social", "kind": "specialist", "status": "planned", "phase": 5, "label_ar": "إعلانات السوشال",
     "routing": {"intents": ["ads"]},
     "capabilities": {"required_any": [["external:meta"], ["external:tiktok"], ["export:social_ads"]], "optional": []},
     "upstream": [{"path": "paid-media/paid-media-paid-social-strategist.md"}]},
    {"id": "email_retention", "kind": "specialist", "status": "planned", "phase": 6, "label_ar": "الاحتفاظ والرسائل",
     "routing": {"intents": ["retention"]},
     "capabilities": {"required_any": [["orders.list", "customers.list"]], "optional": ["external:email"]},
     "upstream": [{"path": "marketing/marketing-email-strategist.md"}]},
    {"id": "business_strategist", "kind": "specialist", "status": "planned", "phase": 6, "label_ar": "الاستراتيجي",
     "routing": {"intents": ["strategy"]},
     "capabilities": {"required_any": [["orders.list"], ["export:orders"]], "optional": ["public:pages"]},
     "upstream": [{"path": "specialized/business-strategist.md"}]}
  ],
  "upstream_repository": {"url": "https://github.com/msitarzewski/agency-agents", "commit": "83294689da3832c0a9f223221148c411fd3eacc0", "license": "MIT"}
}
